<header class="hero">
  <span class="flotante f1">{{{iconoCategoria "Ave"}}}</span>
  <span class="flotante f2">{{{iconoCategoria "Anfibio"}}}</span>
  <span class="flotante f3 anim-mecerse">{{{icono "hoja"}}}</span>
  <span class="flotante f4">{{{icono "bosque"}}}</span>
  <span class="flotante f5 anim-revolotear">{{{icono "mariposa"}}}</span>
  <div class="container position-relative">
    <div class="aparecer">
      <span class="stat-pill mb-3"><i class="bi bi-geo-alt-fill"></i> Piedemonte Amazónico · Caquetá</span>
      <h1 class="mb-2">Monitoreo de Biodiversidad</h1>
      <p class="mb-3">Registra en tiempo real los avistamientos de fauna y flora de El Caraño, el río Hacha y la cordillera Oriental.</p>
      <span class="stat-pill"><i class="bi bi-database-fill-check"></i> {{avistamientos.length}} avistamientos en MongoDB Atlas</span>
    </div>
  </div>
</header>

<main class="container pb-4 position-relative">
  {{#if error}}
    <div class="alert alerta-bio alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
      <i class="bi bi-exclamation-circle-fill fs-5"></i>
      <div>{{error}}</div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  {{/if}}

  <section class="card-bio p-4 p-md-5 mb-5 aparecer retraso-1">
    <div class="card-titulo mb-4">
      <div class="icono"><i class="bi bi-plus-lg"></i></div>
      <div>
        <h2 class="h4 mb-0">Registrar nuevo avistamiento</h2>
        <small class="text-secondary">Los campos con <span class="text-success fw-bold">*</span> son obligatorios</small>
      </div>
    </div>

    <form action="/api/avistamientos" method="POST" class="row g-4">
      <div class="col-md-6">
        <div class="form-floating">
          <input type="text" class="form-control" id="nombreComun" name="nombreComun" placeholder="Danta amazónica" required>
          <label for="nombreComun"><i class="bi bi-tag me-1"></i> Nombre común *</label>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-floating">
          <input type="text" class="form-control fst-italic" id="nombreCientifico" name="nombreCientifico" placeholder="Tapirus terrestris" required>
          <label for="nombreCientifico"><i class="bi bi-journal-text me-1"></i> Nombre científico *</label>
        </div>
      </div>

      <div class="col-12">
        <div class="campo-titulo">Categoría <span class="req">*</span></div>
        <div class="chips">
          {{#each categorias}}
            <div class="chip">
              <input type="radio" name="categoria" id="cat-{{@index}}" value="{{this}}" required>
              <label for="cat-{{@index}}">{{{iconoCategoria this}}}{{this}}</label>
            </div>
          {{/each}}
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-floating">
          <input type="text" class="form-control" id="zona" name="zona" placeholder="Río Hacha" list="zonas" required>
          <label for="zona"><i class="bi bi-geo-alt me-1"></i> Zona *</label>
        </div>
        <datalist id="zonas">
          <option value="Río Hacha">
          <option value="El Caraño">
          <option value="Serranía de Chiribiquete">
          <option value="Cordillera Oriental">
        </datalist>
      </div>
      <div class="col-md-6">
        <div class="form-floating">
          <input type="text" class="form-control" id="investigador" name="investigador" placeholder="Nombre del estudiante o docente" required>
          <label for="investigador"><i class="bi bi-person-badge me-1"></i> Investigador *</label>
        </div>
      </div>

      <div class="col-12">
        <div class="campo-titulo">Estado de conservación</div>
        <div class="estados">
          {{#each estados}}
            <div class="estado {{claseEstado this}}">
              <input type="radio" name="estadoConservacion" id="est-{{@index}}" value="{{this}}" {{#if @first}}checked{{/if}}>
              <label for="est-{{@index}}">
                {{#if (eq (claseEstado this) 'success')}}<i class="bi bi-shield-check"></i>{{/if}}
                {{#if (eq (claseEstado this) 'warning')}}<i class="bi bi-exclamation-triangle"></i>{{/if}}
                {{#if (eq (claseEstado this) 'danger')}}<i class="bi bi-exclamation-octagon"></i>{{/if}}
                {{this}}
              </label>
            </div>
          {{/each}}
        </div>
      </div>

      <div class="col-12 d-flex justify-content-end">
        <button type="submit" class="btn btn-bio px-4">
          <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
          <span class="texto-btn"><i class="bi bi-cloud-arrow-up me-2"></i>Guardar avistamiento</span>
        </button>
      </div>
    </form>
  </section>

  <section class="aparecer retraso-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-3">
      <div class="card-titulo d-flex align-items-center gap-2">
        <h2 class="h4 fw-bold mb-0">Avistamientos registrados</h2>
        <span class="badge rounded-pill text-bg-success">{{avistamientos.length}}</span>
      </div>
      <form action="/" method="GET">
        <select name="categoria" class="form-select filtro-select" onchange="this.form.submit()" aria-label="Filtrar por categoría">
          <option value="">Todas las categorías</option>
          {{#each categorias}}
            <option value="{{this}}" {{#if (eq this ../categoriaActual)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </form>
    </div>

    {{#if avistamientos.length}}
      <div class="table-responsive">
        <table class="table tabla-bio align-middle mb-0">
          <thead>
            <tr>
              <th>Especie</th>
              <th>Categoría</th>
              <th>Zona</th>
              <th>Estado</th>
              <th>Investigador</th>
              <th>Fecha</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {{#each avistamientos}}
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar-especie {{claseCategoria categoria}}">{{{iconoCategoria categoria}}}</div>
                    <div>
                      <div class="fw-semibold">{{nombreComun}}</div>
                      <small class="fst-italic text-secondary">{{nombreCientifico}}</small>
                    </div>
                  </div>
                </td>
                <td>{{categoria}}</td>
                <td><i class="bi bi-geo-alt text-success me-1"></i>{{zona}}</td>
                <td><span class="badge badge-estado text-bg-{{claseEstado estadoConservacion}}">{{estadoConservacion}}</span></td>
                <td>{{investigador}}</td>
                <td><small class="text-secondary">{{formatoFecha fechaRegistro}}</small></td>
                <td class="text-end text-nowrap">
                  <a href="/editar/{{_id}}" class="btn btn-outline-primary btn-accion" title="Editar" aria-label="Editar">
                    <i class="bi bi-pencil-square"></i>
                  </a>
                  <form action="/api/avistamientos/delete/{{_id}}" method="POST" class="d-inline"
                        onsubmit="return confirm('¿Eliminar este avistamiento?');">
                    <button type="submit" class="btn btn-outline-danger btn-accion ms-1" title="Eliminar" aria-label="Eliminar">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </form>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="card-bio vacio">
        <div class="vacio-icono mb-2">{{{icono "binoculares"}}}</div>
        <p class="mb-0">Aún no hay avistamientos registrados{{#if categoriaActual}} en esta categoría{{/if}}.</p>
      </div>
    {{/if}}
  </section>
</main>
