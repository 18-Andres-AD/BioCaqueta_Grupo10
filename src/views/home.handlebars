<!-- Formulario de registro -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white">
    <h2 class="h5 mb-0">Registrar nuevo avistamiento</h2>
  </div>
  <div class="card-body">
    <form action="/api/avistamientos" method="POST" class="row g-3">
      <div class="col-md-6">
        <label for="nombreComun" class="form-label">Nombre común *</label>
        <input type="text" class="form-control" id="nombreComun" name="nombreComun" placeholder="Danta amazónica" required>
      </div>
      <div class="col-md-6">
        <label for="nombreCientifico" class="form-label">Nombre científico *</label>
        <input type="text" class="form-control fst-italic" id="nombreCientifico" name="nombreCientifico" placeholder="Tapirus terrestris" required>
      </div>
      <div class="col-md-4">
        <label for="categoria" class="form-label">Categoría *</label>
        <select class="form-select" id="categoria" name="categoria" required>
          <option value="" selected disabled>Seleccione...</option>
          {{#each categorias}}
            <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-4">
        <label for="zona" class="form-label">Zona *</label>
        <input type="text" class="form-control" id="zona" name="zona" placeholder="Río Hacha" list="zonas" required>
        <datalist id="zonas">
          <option value="Río Hacha">
          <option value="El Caraño">
          <option value="Serranía de Chiribiquete">
          <option value="Cordillera Oriental">
        </datalist>
      </div>
      <div class="col-md-4">
        <label for="estadoConservacion" class="form-label">Estado de conservación</label>
        <select class="form-select" id="estadoConservacion" name="estadoConservacion">
          {{#each estados}}
            <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-8">
        <label for="investigador" class="form-label">Investigador *</label>
        <input type="text" class="form-control" id="investigador" name="investigador" placeholder="Nombre del estudiante o docente" required>
      </div>
      <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-success w-100">Guardar avistamiento</button>
      </div>
    </form>
  </div>
</div>

<!-- Listado -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h2 class="h5 mb-0">Avistamientos registrados ({{avistamientos.length}})</h2>
  <form action="/" method="GET" class="d-flex gap-2">
    <select name="categoria" class="form-select form-select-sm" onchange="this.form.submit()">
      <option value="">Todas las categorías</option>
      {{#each categorias}}
        <option value="{{this}}" {{#if (eq this ../categoriaActual)}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
  </form>
</div>

{{#if avistamientos.length}}
  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm">
      <thead class="table-success">
        <tr>
          <th>Especie</th>
          <th>Categoría</th>
          <th>Zona</th>
          <th>Estado</th>
          <th>Investigador</th>
          <th>Fecha</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each avistamientos}}
          <tr>
            <td>
              <strong>{{nombreComun}}</strong><br>
              <small class="fst-italic text-muted">{{nombreCientifico}}</small>
            </td>
            <td>{{categoria}}</td>
            <td>{{zona}}</td>
            <td><span class="badge text-bg-{{claseEstado estadoConservacion}}">{{estadoConservacion}}</span></td>
            <td>{{investigador}}</td>
            <td><small>{{formatoFecha fechaRegistro}}</small></td>
            <td class="text-end text-nowrap">
              <a href="/editar/{{_id}}" class="btn btn-sm btn-outline-primary">Editar</a>
              <form action="/api/avistamientos/delete/{{_id}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Eliminar este avistamiento?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="alert alert-info">Aún no hay avistamientos registrados.</div>
{{/if}}
