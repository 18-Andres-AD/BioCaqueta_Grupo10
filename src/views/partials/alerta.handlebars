{{#if error}}
  <div class="alert alerta-bio alert-dismissible fade show d-flex align-items-center gap-2 mb-4 {{clase}}" role="alert">
    <i class="bi bi-exclamation-circle-fill fs-5"></i>
    <div>{{error}}</div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
{{/if}}
