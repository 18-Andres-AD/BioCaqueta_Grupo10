<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BioCaquetá | {{titulo}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🌿 BioCaquetá</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/">Avistamientos</a>
        <a class="nav-link" href="/api/avistamientos" target="_blank">API (JSON)</a>
      </div>
    </div>
  </nav>

  <main class="container pb-5">
    {{#if error}}
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{error}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
      </div>
    {{/if}}

    {{{body}}}
  </main>

  <footer class="text-center text-muted small py-3 border-top">
    Universidad de la Amazonia · Ingeniería de Sistemas · Florencia, Caquetá
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
