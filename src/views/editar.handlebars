<header class="hero">
  <span class="flotante f1"><span class="ico-cat {{claseCategoria avistamiento.categoria}}"><i class="{{iconoCategoria avistamiento.categoria}} ico"></i></span></span>
  <span class="flotante f3 anim-mecerse"><i class="mdi mdi-leaf ico"></i></span>
  <span class="flotante f4"><i class="mdi mdi-forest ico"></i></span>
  <span class="flotante f5 anim-revolotear"><i class="mdi mdi-butterfly ico"></i></span>
  <div class="container position-relative">
    <div class="aparecer">
      <a href="/" class="stat-pill text-white text-decoration-none mb-3"><i class="bi bi-arrow-left"></i> Volver al listado</a>
      <h1 class="mb-2">Editar avistamiento</h1>
      <p class="mb-0">Actualiza la zona o el estado de conservación de <strong>{{avistamiento.nombreComun}}</strong>.</p>
    </div>
  </div>
</header>

<main class="container pb-4 position-relative">
  {{#if error}}
    <div class="alert alerta-bio alert-dismissible fade show d-flex align-items-center gap-2 mb-4 contenedor-estrecho mx-auto" role="alert">
      <i class="bi bi-exclamation-circle-fill fs-5"></i>
      <div>{{error}}</div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  {{/if}}

  <section class="card-bio contenedor-estrecho p-4 p-md-5 mx-auto aparecer retraso-1">

    <div class="d-flex align-items-center gap-3 mb-4">
      <div class="avatar-especie avatar-grande {{claseCategoria avistamiento.categoria}}"><i class="{{iconoCategoria avistamiento.categoria}} ico"></i></div>
      <div>
        <h2 class="h4 mb-0">{{avistamiento.nombreComun}}</h2>
        <div class="fst-italic text-secondary">{{avistamiento.nombreCientifico}}</div>
      </div>
      <span class="badge badge-estado text-bg-{{claseEstado avistamiento.estadoConservacion}} ms-auto">{{avistamiento.estadoConservacion}}</span>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-sm-4">
        <div class="dato-bloque p-3 rounded-4 h-100">
          <small class="text-secondary d-block">Categoría</small>
          <span class="fw-semibold">{{avistamiento.categoria}}</span>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="dato-bloque p-3 rounded-4 h-100">
          <small class="text-secondary d-block">Investigador</small>
          <span class="fw-semibold">{{avistamiento.investigador}}</span>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="dato-bloque p-3 rounded-4 h-100">
          <small class="text-secondary d-block">Registrado</small>
          <span class="fw-semibold">{{formatoFecha avistamiento.fechaRegistro}}</span>
        </div>
      </div>
    </div>

    <hr class="my-4 opacity-25">

    <form action="/api/avistamientos/update/{{avistamiento._id}}" method="POST" class="row g-4">
      <div class="col-12">
        <div class="form-floating">
          <input type="text" class="form-control" id="zona" name="zona" value="{{avistamiento.zona}}" placeholder="Zona" list="zonas" required>
          <label for="zona"><i class="bi bi-geo-alt me-1"></i> Zona *</label>
        </div>
        <datalist id="zonas">
          {{#each zonas}}
            <option value="{{this}}">
          {{/each}}
        </datalist>
      </div>

      <div class="col-12">
        <div class="campo-titulo">Estado de conservación</div>
        <div class="estados">
          {{#each estados}}
            <div class="estado {{claseEstado this}}">
              <input type="radio" name="estadoConservacion" id="est-{{@index}}" value="{{this}}" {{#if (eq this ../avistamiento.estadoConservacion)}}checked{{/if}}>
              <label for="est-{{@index}}"><i class="bi {{iconoEstado this}}"></i> {{this}}</label>
            </div>
          {{/each}}
        </div>
      </div>

      <div class="col-12 d-flex justify-content-end gap-2">
        <a href="/" class="btn btn-outline-secondary btn-suave px-4 d-inline-flex align-items-center">Cancelar</a>
        <button type="submit" class="btn btn-bio px-4">
          <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
          <span class="texto-btn"><i class="bi bi-check2-circle me-2"></i>Guardar cambios</span>
        </button>
      </div>
    </form>
  </section>
</main>
